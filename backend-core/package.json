{
  "name": "nexus-academy-backend-core",
  "version": "2.0.0",
  "description": "Backend Core API for Nexus Academy SaaS - Full Featured",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:simple": "node src/server-simple.js",
    "dev": "nodemon src/server.js",
    "dev:simple": "nodemon src/server-simple.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src/",
    "seed": "node src/scripts/seed.js",
    "validate-env": "node validate-env.js",
    "predeploy": "npm run validate-env",
    "deploy:check": "npm run validate-env && npm run lint && npm test"
  },
  "keywords": [
    "nexus",
    "education",
    "saas",
    "lms"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "assemblyai": "^4.22.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^129.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.14.0",
    "redis": "^4.6.12",
    "resend": "^6.6.0",
    "socket.io": "^4.6.1",
    "stripe": "^14.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@express-rate-limit/tsconfig": "^1.0.2",
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
