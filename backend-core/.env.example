# Ambiente
NODE_ENV=production

# Servidor
PORT=5000

# URLs
FRONTEND_URL=https://seu-frontend.onrender.com
API_URL=https://seu-backend.onrender.com

# Segurança
JWT_SECRET=seu-jwt-secret-muito-seguro-aqui
ENCRYPTION_KEY=sua-encryption-key-muito-segura-aqui

# MongoDB (opcional - se não configurado, usa memória)
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/nexus-academy

# Stripe (opcional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# Resend (email - opcional)
RESEND_API_KEY=re_...

# Cloudinary (upload de imagens - opcional)
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
CLOUDINARY_URL=cloudinary://...

# AssemblyAI (transcrição - opcional)
ASSEMBLYAI_API_KEY=sua-assemblyai-key

# Daily.co (videoconferência - opcional)
DAILY_API_KEY=sua-daily-key

# CORS Origins (separados por vírgula)
CORS_ORIGIN=http://localhost:5173,https://seu-frontend.onrender.com
