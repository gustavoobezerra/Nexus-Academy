# ======================================
# NEXUS ACADEMY - VARIÁVEIS DE PRODUÇÃO
# ======================================
# Copie este arquivo e configure com seus valores reais

# Ambiente
NODE_ENV=production
PORT=5000

# ======================================
# MONGODB
# ======================================
# Use seu cluster MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/nexus-academy?retryWrites=true&w=majority

# ======================================
# SEGURANÇA
# ======================================
# IMPORTANTE: Gere chaves fortes para produção!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua-chave-jwt-super-secreta-aqui
ENCRYPTION_KEY=sua-chave-encryption-super-secreta-aqui

# ======================================
# CORS
# ======================================
# URLs do seu deploy
FRONTEND_URL=https://seu-app.onrender.com
API_URL=https://seu-backend.onrender.com

# ======================================
# STRIPE (Assinatura do Professor)
# ======================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ======================================
# EMAIL (Resend)
# ======================================
RESEND_API_KEY=re_...

# ======================================
# CLOUDINARY (Upload de arquivos)
# ======================================
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# ======================================
# ASSEMBLYAI (Transcrição de áudio)
# ======================================
ASSEMBLYAI_API_KEY=sua-api-key

# ======================================
# DAILY.CO (Videoconferência)
# ======================================
DAILY_API_KEY=sua-api-key

# ======================================
# GOOGLE GEMINI (IA - Opcional)
# ======================================
GEMINI_API_KEY=AIzaSy...
